{
  "config": {
    "step": {
      "user": {
        "title": "BYD Leopard 3",
        "description": "Connect a car that sends telemetry to a Home Assistant webhook: BYDMate, BYD EV Pro, or any app that can POST JSON.",
        "data": {
          "name": "Name",
          "model": "Model",
          "source": "Data source",
          "field_map": "Field map (JSON, only for custom sources)"
        },
        "data_description": {
          "field_map": "Example: `{example}`. See the README for paths, scale and value maps."
        }
      },
      "webhook": {
        "title": "Webhook URL",
        "description": "Paste this URL into your app (in BYDMate: Settings → Integrations → Webhook: telemetry, then turn on Live data → your own server). The car appears as soon as the first packet arrives.\n\n`{webhook_url}`"
      }
    },
    "error": {
      "invalid_json": "The field map is not a valid JSON object."
    }
  },
  "options": {
